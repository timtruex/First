# ============================================================
# Polymarket Latency Arb Bot – Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ------------------------------------------------------------
# Polymarket CLOB credentials
# Get these from https://polymarket.com after connecting wallet
# ------------------------------------------------------------
POLY_PRIVATE_KEY=0x_your_evm_private_key_here
POLY_API_KEY=your_api_key
POLY_API_SECRET=your_api_secret
POLY_API_PASSPHRASE=your_api_passphrase

# Chain: 137=Polygon mainnet, 80002=Amoy testnet
CHAIN_ID=137

# CLOB host (usually no need to change)
CLOB_HOST=https://clob.polymarket.com

# ------------------------------------------------------------
# Contract token IDs
# Find these on Polymarket: open a BTC/ETH price contract,
# inspect the URL or API response for the token_id.
# Each binary contract has two token IDs (YES / NO).
# ------------------------------------------------------------
TOKEN_BTC_5M_UP=
TOKEN_BTC_5M_DOWN=
TOKEN_BTC_15M_UP=
TOKEN_BTC_15M_DOWN=
TOKEN_ETH_5M_UP=
TOKEN_ETH_5M_DOWN=
TOKEN_ETH_15M_UP=
TOKEN_ETH_15M_DOWN=

# ------------------------------------------------------------
# Arbitrage thresholds  (keep defaults unless you know why)
# ------------------------------------------------------------
# Minimum observed lag to generate a signal (percentage points)
LAG_THRESHOLD_PCT=3.0

# Minimum edge after fees to consider a trade (percentage points)
MIN_EDGE_PCT=5.0

# Minimum model confidence score [0-100] to execute a trade
MIN_CONFIDENCE=85.0

# Maximum fraction of equity in any single position  (0-1)
MAX_POSITION_FRACTION=0.08

# How often to poll the CLOB orderbook (seconds)
CLOB_POLL_INTERVAL=2.0

# ------------------------------------------------------------
# Kelly Criterion
# ------------------------------------------------------------
# 0.5 = half-Kelly (recommended); 1.0 = full Kelly (aggressive)
KELLY_FRACTION=0.5

# ------------------------------------------------------------
# Portfolio / risk
# ------------------------------------------------------------
# Starting paper-trading equity in USDC
STARTING_PORTFOLIO_USDC=1000

# Daily drawdown kill-switch (fraction, 0.20 = 20%)
MAX_DAILY_DRAWDOWN=0.20

# ------------------------------------------------------------
# Trading mode
# *** DEFAULT IS PAPER TRADING ***
# To switch to live trading ALL FOUR of the following must be set
# ------------------------------------------------------------
PAPER_TRADING=true

# Uncomment and set all three to enable live trading:
# PAPER_TRADING=false
# LIVE_CONFIRM_1=true
# LIVE_CONFIRM_2=true
# LIVE_CONFIRM_3=true

# ------------------------------------------------------------
# Telegram alerts
# 1. Create a bot via @BotFather and copy the token.
# 2. Send a message to your bot, then call:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    to find your chat_id.
# ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Drawdown level that triggers an alert (fraction)
TELEGRAM_DRAWDOWN_ALERT_PCT=0.10

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
LOG_LEVEL=INFO
