<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd service for continuous scanning on macOS.

  Install with deploy/install-macos.sh, which substitutes the paths below.
  Do not edit this file in place once installed - edit it here and re-run the
  installer, so the repo stays the source of truth.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.kalshiarb.scanner</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>__SCANNER_DIR__/main.py</string>
        <string>watch</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__SCANNER_DIR__</string>

    <!-- Start at load and restart if the process exits for any reason. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- Do not respawn faster than this. Without it, a config error that
         crashes on startup becomes a hot restart loop that burns CPU and
         fills the log with the same traceback thousands of times. -->
    <key>ThrottleInterval</key>
    <integer>60</integer>

    <!-- launchd sends SIGTERM then SIGKILLs after this many seconds. The
         daemon handles SIGTERM by finishing its current cycle, so this only
         needs to exceed one cycle's worth of in-flight HTTP. -->
    <key>ExitTimeOut</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>__SCANNER_DIR__/data/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__SCANNER_DIR__/data/launchd.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <!-- Keep the machine awake while this runs, so a sleeping Mac mini does
         not silently stop scanning. Pair with: sudo pmset -a sleep 0 -->
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <false/>
</dict>
</plist>
