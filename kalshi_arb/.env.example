# ---------------------------------------------------------------------
# Kalshi <-> Polymarket cross-venue scanner
#
# Every value here is optional. With none of them set the scanner runs
# read-only against public market data and cannot place an order.
# ---------------------------------------------------------------------

# --- Safety -----------------------------------------------------------
# Order placement is blocked unless this is set to the EXACT string below.
# Any other value - unset, "true", "1", a typo - keeps DRY_RUN active.
# KALSHI_ARB_LIVE=I_UNDERSTAND_THIS_PLACES_REAL_ORDERS

# --- Kalshi credentials (needed only for portfolio reads and orders) ---
# Generate an API key in Kalshi account settings; register the public half
# and point KALSHI_PRIVATE_KEY_PATH at the private half.
# KALSHI_KEY_ID=
# KALSHI_PRIVATE_KEY_PATH=~/.kalshi/private_key.pem
# KALSHI_USE_DEMO=false

# --- Rate limits ------------------------------------------------------
# Token bucket. Order mutations cost 15 tokens each, reads cost 1, so a
# capacity of 100 admits 6 mutations of burst. Verify against Kalshi's
# current published limits before raising these.
# KALSHI_BUCKET_CAPACITY=100
# KALSHI_REFILL_PER_SEC=10
# POLY_BUCKET_CAPACITY=60
# POLY_REFILL_PER_SEC=6

# --- Scan thresholds --------------------------------------------------
# Minimum net profit per contract, in dollars, after all fees. Below about
# half a cent the edge is inside the noise of both books.
# MIN_NET_EDGE_PER_CONTRACT=0.005
# MIN_CONTRACTS=10
# BOOK_DEPTH=10

# LOG_LEVEL=INFO

# --- Continuous operation (the `watch` command) -----------------------
# Seconds between scan cycles. Cross-venue spreads on event markets persist
# for minutes to hours, so this is not a latency race - a tighter interval
# mostly spends rate-limit budget re-reading unchanged books.
# SCAN_INTERVAL_SEC=60
# MAX_BACKOFF_SEC=900

# Alert suppression. A spread that persists for six hours is ONE opportunity;
# at a 60s interval an unsuppressed notifier would report it 360 times. Only
# re-alert the same (pair, direction) after the cooldown, or when its net edge
# per contract improves by at least ALERT_IMPROVEMENT.
# ALERT_COOLDOWN_SEC=3600
# ALERT_IMPROVEMENT=0.01

# Alert on unverified (RESEARCH) pairs too. Off by default: being woken for a
# spread you cannot yet trade is how an alert channel gets muted.
# ALERT_ON_RESEARCH=false

# --- Alert channels ---------------------------------------------------
# Console is always on. macOS banners are on by default and no-op elsewhere.
# MACOS_NOTIFICATIONS=true
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
